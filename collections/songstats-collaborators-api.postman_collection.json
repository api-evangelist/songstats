  "info": {
    "_postman_id": "0a662bc0-6944-4360-91d0-ce7cdeb4073c",
    "name": "Songstats Enterprise Artists Collaborators API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Songstats Enterprise API provides music data analytics for artists, tracks, labels, and collaborators across all major streaming platforms. Endpoints return JSON data including current stats, historic stats, audience details, catalog, activities, and playlist data. Used by music industry professionals to build dashboards, reports, and data-driven tools.\n\nContact Support:\n Name: Songstats API Support\n Email: api@songstats.com",
      "type": "text/plain"
    }
  }
